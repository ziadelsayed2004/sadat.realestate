: var(--space-xl);\n  min-width: 0;\n  padding: .75rem clamp(1.25rem, 3vw, 3.5rem);\n  background: #fff;\n  border-block-end: 1px solid #e4e0d7;\n}\n\n[dir=\"rtl\"] .seeker-dashboard__topbar { grid-template-columns: minmax(13rem, auto) minmax(20rem, 46rem) auto; }\n\n.seeker-dashboard__menu-button {\n  display: grid;\n  place-items: center;\n  inline-size: 2.75rem;\n  block-size: 2.75rem;\n  color: #17233d;\n  background: transparent;\n  border: 0;\n  border-radius: 50%;\n  font: inherit;\n  font-size: 1.45rem;\n}\n\n.seeker-dashboard__search {\n  display: flex;\n  align-items: center;\n  gap: .75rem;\n  min-width: 0;\n  padding: .7rem 1.25rem;\n  color: #7d8492;\n  background: #f8ecd2;\n  border: 1px solid #dfd4bc;\n  border-radius: 999px;\n}\n\n.seeker-dashboard__search input { width: 100%; min-width: 0; color: #17233d; background: transparent; border: 0; outline: 0; font: inherit; }\n.seeker-dashboard__topbar-profile,\n.seeker-dashboard__nav-footer { display: flex; align-items: center; gap: .75rem; color: #17233d; text-decoration: none; }\n.seeker-dashboard__topbar-profile span:last-child,\n.seeker-dashboard__nav-footer > span:nth-child(2) { display: grid; }\n.seeker-dashboard__topbar-profile small,\n.seeker-dashboard__nav-footer small { color: #0f4a3b; }\n\n.seeker-dashboard__avatar {\n  display: grid;\n  place-items: center;\n  inline-size: 2.75rem;\n  block-size: 2.75rem;\n  flex: 0 0 auto;\n  color: #0f4a3b;\n  background: #f3e8d0;\n  border: 1px solid #ded3bc;\n  border-radius: 50%;\n  font-weight: 800;\n}\n\n.seeker-dashboard__nav {\n  grid-column: 1;\n  grid-row: 2;\n  position: sticky;\n  inset-block-start: 0;\n  align-self: start;\n  display: flex;\n  flex-direction: column;\n  min-height: calc(100vh - 5rem);\n  padding: 1.25rem .9rem;\n  background: #fff;\n  border-inline-end: 1px solid #e4e0d7;\n}\n\n.seeker-dashboard__brand { display: grid; place-items: center; min-block-size: 3.8rem; margin-block-end: 1rem; }\n.seeker-dashboard__brand img { inline-size: auto; block-size: 3.2rem; object-fit: contain; }\n.seeker-dashboard__nav ul { gap: .35rem; margin: .5rem 0 2rem; }\n.seeker-dashboard__nav a { min-block-size: 3.55rem; padding: .8rem 1rem; border-radius: 1rem; font-weight: 700; }\n.seeker-dashboard__nav-icon { color: #7d8492; }\n.seeker-dashboard__nav a[data-active=\"true\"] .seeker-dashboard__nav-icon { color: #fff; }\n\n.seeker-dashboard__nav-footer {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  margin-block-start: auto;\n  padding: 1rem;\n  background: #f8ecd2;\n  border-radius: 1rem;\n}\n\n.seeker-dashboard__nav-footer > a {\n  grid-column: 1 / -1;\n  justify-content: space-between;\n  min-block-size: 2.5rem;\n  margin-block-start: .75rem;\n  padding: .5rem 0 0;\n  color: #5f6878;\n  border-block-start: 1px solid #ded3bc;\n  border-radius: 0;\n}\n\n.seeker-dashboard__content {\n  grid-column: 2;\n  grid-row: 2;\n  width: min(100%, 86rem);\n  margin-inline: auto;\n  padding: clamp(2rem, 4vw, 4.5rem);\n}\n\n.seeker-dashboard__heading-row h1 { margin: .15rem 0 .35rem; font-size: clamp(2.15rem, 3vw, 3.25rem); }\n.seeker-dashboard__eyebrow { text-transform: none; letter-spacing: 0; }\n.seeker-dashboard__summary,\n.seeker-dashboard__activity,\n.seeker-requests__panel,\n.seeker-viewings__panel,\n.seeker-notifications__panel { margin-block-start: 2rem; }\n.seeker-dashboard__summary-grid { gap: 1rem; }\n.seeker-dashboard__summary-card { min-block-size: 8.5rem; align-content: center; padding: 1.35rem; border: 0; box-shadow: none; }\n.seeker-dashboard__summary-card strong { font-size: 2rem; }\n\n.seeker-dashboard__overview-grid {\n  display: grid;\n  grid-template-columns: minmax(14rem, .8fr) minmax(20rem, 1.35fr);\n  grid-template-areas:\n    \"viewings requests\"\n    \"notifications requests\"\n    \"cta cta\";\n  gap: 1rem;\n}\n[dir=\"rtl\"] .seeker-dashboard__overview-grid {\n  grid-template-areas:\n    \"requests viewings\"\n    \"requests notifications\"\n    \"cta cta\";\n}\n.seeker-dashboard__overview-panel {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 1rem;\n  min-block-size: 8rem;\n  padding: 1.5rem;\n  color: #17233d;\n  background: #fff;\n  border: 1px solid #e7e0d2;\n  border-radius: 1.15rem;\n  text-decoration: none;\n}\n.seeker-dashboard__overview-panel > span { display: grid; place-items: center; inline-size: 3rem; block-size: 3rem; color: #0f4a3b; background: #eaf1ee; border-radius: 50%; font-size: 1.4rem; }\n.seeker-dashboard__overview-panel > div { display: grid; gap: .35rem; }\n.seeker-dashboard__overview-panel small { color: #7d8492; }\n.seeker-dashboard__overview-panel b { color: #0f4a3b; font-size: 1.65rem; }\n.seeker-dashboard__overview-panel--requests { grid-area: requests; align-content: center; }\n.seeker-dashboard__overview-panel--viewings { grid-area: viewings; }\n.seeker-dashboard__overview-panel--notifications { grid-area: notifications; }\n.seeker-dashboard__overview-panel--wide { grid-area: cta; color: #fff; background: #0f4a3b; }\n.seeker-dashboard__overview-panel--wide > span { color: #fff; background: rgb(255 255 255 / 14%); }\n.seeker-dashboard__overview-panel--wide small,\n.seeker-dashboard__overview-panel--wide b { color: #f3e8d0; }\n\n.seeker-requests__panel,\n.seeker-viewings__panel,\n.seeker-notifications__panel,\n.seeker-profile__panel,\n.seeker-profile__settings-card { border: 0; box-shadow: none; }\n.seeker-requests__columns,\n.seeker-request-row { grid-template-columns: minmax(0, 1.6fr) minmax(0, .85fr) minmax(0, .9fr) minmax(0, .65fr); }\n.seeker-request-row__identity strong,\n.seeker-request-row__identity span { overflow-wrap: anywhere; }\n.seeker-request-detail__grid { grid-template-columns: minmax(0, 1.55fr) minmax(19rem, .85fr); }\n.seeker-request-detail__card { border: 0; box-shadow: none; }\n.seeker-request-detail__timeline li:not(:last-child) { position: relative; padding-block-end: 1rem; }\n.seeker-request-detail__timeline li:not(:last-child)::after { content: ''; position: absolute; inset-block-start: 2.5rem; inset-inline-start: 1.2rem; width: 2px; height: calc(100% - 1.5rem); background: #d6ded9; }\n\n.seeker-viewings__heading-actions .ui-button--primary { color: #fff; background: #0f4a3b; box-shadow: 0 8px 20px rgb(15 74 59 / 18%); }\n.seeker-viewings__grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr)); }\n.seeker-viewing-card { grid-template-columns: 1fr; border: 0; box-shadow: 0 8px 24px rgb(23 35 61 / 8%); }\n.seeker-viewing-card__image { inline-size: 100%; min-block-size: 14rem; aspect-ratio: 1.95 / 1; background: linear-gradient(145deg, #dce9e3, #f3e8d0); }\n\n.seeker-saved__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }\n.seeker-saved-property-card { min-width: 0; border: 0; box-shadow: 0 8px 24px rgb(23 35 61 / 8%); }\n.seeker-saved-property-card .ux-state-view { min-block-size: 15rem; border-radius: 0; }\n\n.seeker-notifications__list { gap: 0; overflow: hidden; border: 1px solid #ebe6dc; border-radius: 1rem; }\n.seeker-notifications__item { border: 0; border-radius: 0; border-block-end: 1px solid #ebe6dc; }\n\n.seeker-profile__tabs { width: min(100%, 52rem); box-shadow: none; }\n.seeker-profile__tabs a { flex: 1 1 0; text-align: center; }\n.seeker-profile__panel,\n.seeker-profile__settings { width: min(100%, 56rem); }\n.seeker-profile__settings-card--account { border: 1px solid color-mix(in srgb, var(--color-status-error) 45%, var(--color-border)); }\n\n.seeker-profile__identity {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  padding-block-end: 1.5rem;\n  border-block-end: 1px solid #ebe6dc;\n}\n.seeker-profile__identity-avatar {\n  display: grid;\n  place-items: center;\n  inline-size: 4.5rem;\n  block-size: 4.5rem;\n  flex: 0 0 auto;\n  color: #0f4a3b;\n  background: #f3e8d0;\n  border: 1px solid #dfcfad;\n  border-radius: 50%;\n  font-size: 1.15rem;\n  font-weight: 800;\n}\n.seeker-profile__identity > span:last-child { d