ck-start: 14px; }\n.admin-notifications-audit__actions a,\n.admin-notifications-audit__row-link { color: #2555aa; font-weight: 700; }\n\n.admin-notifications-audit__empty,\n.admin-notifications-audit__state {\n  display: grid;\n  max-width: 760px;\n  gap: 16px;\n  margin: 40px auto;\n  padding: 44px 24px;\n  text-align: center;\n}\n\n.admin-notifications-audit__empty h2,\n.admin-notifications-audit__empty p { margin: 0; }\n.admin-notifications-audit__empty p { color: #63718b; line-height: 1.7; }\n\n.admin-notifications-audit__filter-form {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n  width: 100%;\n}\n\n.admin-notifications-audit__filter-form label {\n  display: grid;\n  gap: 6px;\n  color: #51627f;\n  font-size: .85rem;\n  font-weight: 700;\n}\n\n.admin-notifications-audit__filter-form input {\n  min-height: 42px;\n  padding: 8px 10px;\n  border: 1px solid #ccd6e5;\n  border-radius: 9px;\n  color: #24334f;\n  font: inherit;\n}\n\n.admin-notifications-audit__filter-actions { display: flex; align-items: end; gap: 10px; }\n\n.admin-notifications-audit__table-wrap { overflow-x: auto; }\n.admin-notifications-audit__table { width: 100%; border-collapse: collapse; min-width: 760px; }\n.admin-notifications-audit__table caption { padding: 1px; }\n.admin-notifications-audit__table th,\n.admin-notifications-audit__table td { padding: 14px 18px; border-block-end: 1px solid #edf0f5; text-align: start; vertical-align: top; }\n.admin-notifications-audit__table th { color: #51627f; font-size: .78rem; text-transform: uppercase; letter-spacing: .04em; }\n.admin-notifications-audit__table td { color: #24334f; }\n.admin-notifications-audit__table code { color: #6d788b; font-size: .75rem; overflow-wrap: anywhere; }\n\n.admin-notifications-audit__detail-heading { align-items: flex-start; }\n.admin-notifications-audit__detail-body { display: grid; gap: 20px; padding: 24px; }\n.admin-notifications-audit__detail-grid { display: grid; grid-template-