d-secondary) !important;\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-bold);\n  letter-spacing: 0.08em;\n}\n\n.provider-type-card__body {\n  gap: var(--space-2xl);\n}\n\n.provider-type-options {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--space-md);\n}\n\n.provider-type-option {\n  display: grid;\n  align-content: start;\n  gap: var(--space-md);\n  min-block-size: 13rem;\n  padding: var(--space-lg);\n  color: var(--color-text-strong);\n  text-align: start;\n  background: var(--color-page-background);\n  border: 2px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  cursor: pointer;\n  font: inherit;\n  text-decoration: none;\n  transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;\n}\n\n.provider-type-option:hover {\n  border-color: var(--color-brand-accent);\n  transform: translateY(-1px);\n}\n\n.provider-type-option:focus-visible {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 3px;\n}\n\n.provider-type-option--selected {\n  background: color-mix(in srgb, var(--color-status-success) 9%, var(--color-page-background));\n  border-color: var(--color-status-success);\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-status-success) 26%, transparent);\n}\n\n.provider-type-option__topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-sm);\n}\n\n.provider-type-option__icon {\n  display: grid;\n  place-items: center;\n  inline-size: 3rem;\n  block-size: 3rem;\n  color: var(--color-brand-secondary);\n  background: var(--color-surface-soft);\n  border-radius: var(--radius-md);\n  font-size: 1.55rem;\n  font-weight: var(--font-weight-bold);\n}\n\n.provider-type-option__icon::before,\n.provider-type-option__icon::after {\n  content: '';\n  display: block;\n  position: absolute;\n}\n\n.provider-type-option__icon {\n  position: relative;\n}\n\n.provider-type-option__ico