 width: min(calc(100% - 5rem), 81rem);\n  }\n\n  .public-developer-profile__hero {\n    grid-template-columns: 1fr;\n    overflow: visible;\n    background: rgb(0 0 0 / 25%);\n    border: 0;\n    border-radius: 0;\n    box-shadow: none;\n  }\n\n  .public-developer-profile__hero-media {\n    inline-size: 100vw;\n    block-size: 31rem;\n    margin-inline-start: calc(50% - 50vw);\n  }\n\n  .public-developer-profile__hero-media > img {\n    block-size: 31rem;\n    border-radius: 0;\n  }\n\n  .public-developer-profile__hero-body {\n    position: relative;\n    z-index: 1;\n    width: min(calc(100% - 4rem), 71rem);\n    margin: -5.5rem auto 0;\n    padding: 2.5rem 3rem;\n    background: var(--color-surface);\n    border: 1px solid var(--color-border);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-card);\n  }\n\n  .public-developer-profile__facts {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .public-developer-profile__project-card > img,\n  .public-developer-profile__property-card > img {\n    block-size: 13rem;\n  }\n}\n\n/* Cached clone profile composition.  The profile is a full-width cover followed\n   by a compact identity row and an RTL content canvas with a fixed sidebar. */\n.public-developer-profile__icon {\n  display: inline-block;\n  flex: 0 0 auto;\n  inline-size: 1rem;\n  block-size: 1rem;\n  vertical-align: -0.16em;\n}\n\n.public-developer-profile__identity,\n.public-developer-profile__layout {\n  min-width: 0;\n}\n\n.public-developer-profile__identity-action,\n.public-developer-profile__identity-locations,\n.public-developer-profile__verified,\n.public-developer-profile__project-location,\n.public-developer-profile__verified-mini,\n.public-developer-profile__aside-cta,\n.public-developer-profile__section-heading a,\n.public-developer-profile__inquiry-actions a,\n.public-developer-profile__inquiry-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n}\n\n.public-developer-profile__identity-action,\n.public-developer-profile__aside-cta,\n.public-developer-profile__section-heading a {\n  text-decoration: none;\n}\n\n.public-developer-profile__identity-action:hover,\n.public-developer-profile__aside-cta:hover,\n.public-developer-profile__section-heading a:hover {\n  text-decoration: underline;\n}\n\n.public-developer-profile__identity-locations,\n.public-developer-profile__tags {\n  flex-wrap: wrap;\n}\n\n.public-developer-profile__identity-locations span,\n.public-developer-profile__tags span {\n  display: inline-flex;\n  align-items: center;\n  min-block-size: 1.5rem;\n  padding-inline: 0.625rem;\n  color: var(--color-text-secondary);\n  background: #f3e8d0;\n  border-radius: 999px;\n  font-size: 0.75rem;\n  line-height: 1.25rem;\n}\n\n.public-developer-profile__verified {\n  color: #3d7962;\n  background: #e3f0e9;\n  border-radius: 999px;\n  padding: 0.125rem 0.5rem;\n  font-size: 0.75rem;\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-profile__kind {\n  display: inline-flex;\n  min-block-size: 1.5rem;\n  align-items: center;\n  padding-inline: 0.5rem;\n  color: var(--color-text-secondary);\n  background: var(--color-page-background);\n  border-radius: 999px;\n  font-size: 0.75rem;\n}\n\n.public-developer-profile__identity-logo {\n  position: relative;\n  display: grid;\n  justify-items: end;\n  align-content: start;\n  gap: 0.375rem;\n}\n\n.public-developer-profile__identity-logo > img,\n.public-developer-profile__identity-logo-fallback {\n  display: block;\n  inline-size: 7rem;\n  block-size: 7rem;\n  object-fit: cover;\n  border: 2px solid var(--color-surface);\n  border-radius: 0.75rem;\n  box-shadow: var(--shadow-card);\n}\n\n.public-developer-profile__identity-logo-fallback {\n  background: var(--color-brand-soft);\n}\n\n.public-developer-profile__identity-logo-check {\n  position: absolute;\n  inset-block-start: 6.2rem;\n  inset-inline-start: 0;\n  display: grid;\n  place-items: center;\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n  color: var(--color-on-brand);\n  background: #16735b;\n  border: 2px solid var(--color-page-background);\n  border-radius: 50%;\n}\n\n.public-developer-profile__identity-logo-check .public-developer-profile__icon {\n  inline-size: 0.75rem;\n  block-size: 0.75rem;\n}\n\n.public-developer-profile__aside,\n.public-developer-profile__main {\n  min-width: 0;\n}\n\n.public-developer-profile__aside {\n  display: grid;\n  align-content: start;\n  gap: 1rem;\n}\n\n.public-developer-profile__activity,\n.public-developer-profile__contact-card,\n.public-developer-profile__advisory {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 0.875rem;\n  box-shadow: var(--shadow-card);\n}\n\n.public-developer-profile__activity,\n.public-developer-profile__contact-card {\n  padding: 1rem;\n}\n\n.public-developer-profile__activity h2,\n.public-developer-profile__contact-card h2 {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  margin: 0 0 0.875rem;\n  color: var(--color-text-strong);\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\n.public-developer-profile__metrics {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.public-developer-profile__metric {\n  display: grid;\n  justify-items: center;\n  align-content: center;\n  min-block-size: 4.25rem;\n  padding: 0.5rem;\n  background: #faf8f2;\n  border-radius: 0.75rem;\n  text-align: center;\n}\n\n.public-developer-profile__metric .public-developer-profile__icon {\n  color: var(--color-brand-secondary);\n  inline-size: 0.875rem;\n  block-size: 0.875rem;\n}\n\n.public-developer-profile__metric strong {\n  color: var(--color-text-strong);\n  font-size: 1.125rem;\n  line-height: 1.35;\n}\n\n.public-developer-profile__metric span {\n  color: var(--color-text-secondary);\n  font-size: 0.6875rem;\n  line-height: 1.25;\n}\n\n.public-developer-profile__activity-meta {\n  display: grid;\n  gap: 0.5rem;\n  margin: 0.75rem 0 0;\n  padding-block-start: 0.75rem;\n  border-block-start: 1px solid var(--color-border);\n}\n\n.public-developer-profile__activity-meta div {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 0.5rem;\n}\n\n.public-developer-profile__activity-meta dt,\n.public-developer-profile__activity-meta dd {\n  margin: 0;\n  font-size: 0.75rem;\n}\n\n.public-developer-profile__activity-meta dt {\n  color: var(--color-text-secondary);\n}\n\n.public-developer-profile__activity-meta dd {\n  color: var(--color-text-strong);\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-profile__verified-mini {\n  color: #3d7962;\n}\n\n.public-developer-profile__verified-mini .public-developer-profile__icon {\n  inline-size: 0.75rem;\n  block-size: 0.75rem;\n}\n\n.public-developer-profile__contact-card {\n  display: grid;\n  gap: 0.625rem;\n}\n\n.public-developer-profile__contact-card > a:not(.public-developer-profile__aside-cta) {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: var(--color-text-secondary);\n  font-size: 0.8125rem;\n  text-decoration: none;\n}\n\n.public-developer-profile__contact-card > a:not(.public-developer-profile__aside-cta):hover {\n  color: var(--color-brand-primary);\n}\n\n.public-developer-profile__contact-card p {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: 0.8125rem;\n  line-height: 1.55;\n}\n\n.public-developer-profile__aside-cta {\n  justify-content: center;\n  min-block-size: 2.25rem;\n  margin-block-start: 0.25rem;\n  padding-inline: 0.875rem;\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n  border-radius: 999px;\n  font-size: 0.8125rem;\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-profile__advisory {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.875rem;\n  color: var(--color-text-secondary);\n  background: transparent;\n  box-shadow: none;\n}\n\n.public-developer-profile__advisory > .public-developer-profile__icon {\n  flex: 0 0 auto;\n  color: var(--color-brand-secondary);\n}\n\n.public-developer-profile__advisory strong {\n  display: block;\n  color: var(--color-text-strong);\n  font-size: 0.8125rem;\n}\n\n.public-developer-profile__advisory p {\n  margin: 0.25rem 0 0;\n  font-size: 0.6875rem;\n  line-height: 1.5;\n}\n\n.public-developer-profile__main {\n  display: grid;\n  gap: 2rem;\n}\n\n.public-developer-profile__overview-section,\n.public-developer-profile__projects-section,\n.public-developer-profile__properties-section {\n  background: transparent;\n  border: 0;\n  border-radius: 0;\n  box-shadow: none;\n}\n\n.public-developer-profile__overview-section > h2,\n.public-developer-profile__projects-section > h2,\n.public-developer-profile__properties-section h2,\n.public-developer-profile__contact > h2 {\n  margin: 0 0 0.875rem;\n  padding-inline-start: 0.5rem;\n  color: var(--color-text-strong);\n  border-inline-start: 3px solid var(--color-brand-secondary);\n  font-size: 1.125rem;\n  line-height: 1.5;\n}\n\n.public-developer-profile__overview-card {\n  min-block-size: 27rem;\n  padding: 1.5rem;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 0.875rem;\n  box-shadow: var(--shadow-card);\n}\n\n.public-developer-profile__overview-card > p {\n  margin: 0 0 1rem;\n  color: var(--color-text-secondary);\n  font-size: 0.875rem;\n  line-height: 1.65;\n}\n\n.public-developer-profile__details {\n  display: grid;\n  gap: 0.875rem;\n}\n\n.public-developer-profile__detail-group h3 {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  margin: 0 0 0.375rem;\n  color: var(--color-text-strong);\n  font-size: 0.75rem;\n  line-height: 1.4;\n}\n\n.public-developer-profile__detail-group h3 .public-developer-profile__icon {\n  color: var(--color-brand-secondary);\n  inline-size: 0.875rem;\n  block-size: 0.875rem;\n}\n\n.public-developer-profile__tags {\n  display: flex;\n  gap: 0.375rem;\n}\n\n.public-developer-profile__project-grid {\n  margin-block-start: 0;\n  gap: 1.5rem;\n}\n\n.public-developer-profile__project-card {\n  display: grid;\n  grid-template-rows: 7rem minmax(0, 1fr);\n  gap: 0;\n  min-width: 0;\n  min-block-size: 18rem;\n  overflow: hidden;\n  padding: 0;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 0.875rem;\n  box-shadow: var(--shadow-card);\n}\n\n.public-developer-profile__project-media {\n  position: relative;\n  min-width: 0;\n  overflow: hidden;\n  background: var(--color-brand-soft);\n}\n\n.public-developer-profile__project-media > img,\n.public-developer-profile__project-media-fallback {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n  object-fit: cover;\n}\n\n.public-developer-profile__project-media-fallback,\n.public-developer-profile__property-media-fallback {\n  background: linear-gradient(135deg, var(--color-brand-soft), var(--color-surface-soft));\n}\n\n.public-developer-profile__project-status {\n  position: absolute;\n  inset-block-start: 0.5rem;\n  inset-inline-end: 0.5rem;\n  padding: 0.125rem 0.5rem;\n  color: var(--color-text-strong);\n  background: #fff4cf;\n  border-radius: 999px;\n  font-size: 0.6875rem;\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-profile__project-content {\n  display: grid;\n  align-content: start;\n  gap: 0.375rem;\n  min-width: 0;\n  padding: 0.75rem 1rem 0.875rem;\n}\n\n.public-developer-profile__project-location {\n  justify-self: end;\n  color: var(--color-text-secondary);\n  font-size: 0.6875rem;\n}\n\n.public-developer-profile__project-location .public-developer-profile__icon {\n  inline-size: 0.75rem;\n  block-size: 0.75rem;\n}\n\n.public-developer-profile__project-content h3 {\n  margin: 0;\n  color: var(--color-text-strong);\n  font-size: 1rem;\n  line-height: 1.35;\n}\n\n.public-developer-profile__project-content > p {\n  display: -webkit-box;\n  overflow: hidden;\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: 0.6875rem;\n  line-height: 1.5;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n}\n\n.public-developer-profile__project-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  padding-block-start: 0.375rem;\n  border-block-start: 1px solid var(--color-border);\n}\n\n.public-developer-profile__project-meta span {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 0.25rem;\n  color: var(--color-text-secondary);\n  font-size: 0.625rem;\n}\n\n.public-developer-profile__project-meta strong {\n  color: var(--color-text-strong);\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-profile__project-meta small {\n  font-size: inherit;\n}\n\n.public-developer-profile__project-content > .public-developer-profile__project-price {\n  color: var(--color-brand-secondary);\n  font-size: 0.8125rem;\n  font-weight: var(--font-weight-bold);\n}\n\n.public-developer-profile__project-content > .public-developer-profile__project-link {\n  justify-content: center;\n  justify-self: stretch;\n  min-block-size: 2rem;\n  margin-block-start: auto;\n  padding-inline: 0.75rem;\n  color: var(--color-text-strong);\n  background: #faf8f2;\n  border: 1px solid var(--color-border);\n  border-radius: 999px;\n  font-size: 0.75rem;\n}\n\n.public-developer-profile__project-content > .public-developer-profile__project-link:hover {\n  color: var(--color-brand-primary);\n  text-decoration: none;\n}\n\n.public-developer-profile__properties-section .public-developer-profile__section-heading {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 1rem;\n}\n\n.public-developer-profile__section-heading h2 {\n  margin-block-end: 0;\n}\n\n.public-developer-profile__section-heading a {\n  color: var(--color-brand-secondary);\n  font-size: 0.75rem;\n}\n\n.public-developer-profile__empty--units {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-block-size: 9.5rem;\n  ma