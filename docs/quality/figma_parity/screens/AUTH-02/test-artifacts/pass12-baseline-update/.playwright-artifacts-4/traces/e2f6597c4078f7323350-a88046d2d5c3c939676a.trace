ns {\n  justify-content: end;\n}\n\n.public-homepage__signup,\n.public-homepage__primary-action {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-block-size: var(--button-height-md);\n  padding-inline: var(--space-lg);\n  color: var(--color-on-brand) !important;\n  background: var(--color-brand-secondary);\n  border-radius: var(--radius-md);\n}\n\n.public-homepage__locale {\n  padding-inline-start: var(--space-sm);\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.public-homepage__hero {\n  position: relative;\n  display: grid;\n  min-block-size: clamp(30rem, 52vw, 41rem);\n  isolation: isolate;\n  color: var(--color-on-brand);\n  background: var(--color-brand-secondary);\n}\n\n.public-homepage__hero-media,\n.public-homepage__hero-shade {\n  position: absolute;\n  inset: 0;\n}\n\n.public-homepage__hero-media {\n  z-index: -2;\n  overflow: hidden;\n  background: linear-gradient(130deg, var(--color-brand-secondary), var(--color-brand-primary));\n}\n\n.public-homepage__hero-media > img {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n  object-fit: cover;\n  opacity: 0.72;\n}\n\n.public-homepage__hero-media .public-homepage__missing-media {\n  display: grid;\n  inline-size: 100%;\n  block-size: 100%;\n  place-items: center;\n  opacity: 0.2;\n}\n\n.public-homepage__hero-media .ux-state-view {\n  color: var(--color-on-brand);\n  background: transparent;\n  border: 0;\n  box-shadow: none;\n}\n\n.public-homepage__hero-shade {\n  z-index: -1;\n  background: rgb(18 35 65 / 0.62);\n}\n\n.public-homepage__hero-content {\n  display: grid;\n  align-content: center;\n  gap: var(--space-lg);\n  width: min(100% - clamp(2rem, 8vw, 8rem), 78rem);\n  margin-inline: auto;\n  padding-block: clamp(var(--space-3xl), 8vw, var(--space-4xl));\n}\n\n.public-homepage__eyebrow,\n.public-homepage__content-type,\n.public-homepage__footer-title {\n  margin: 0;\n  color: var(--color-accent-text);\n  font-size: var(