ction-heading {\n  border-block-end: 1px solid rgb(27 41 66 / 14%);\n}\n\n.admin-dashboard__metric-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 15px;\n}\n\n.admin-dashboard__metric {\n  display: grid;\n  min-height: 150px;\n  align-content: start;\n  gap: 8px;\n  padding: 22px;\n  border: 1px solid #e4e4e4;\n  border-radius: 18px;\n  background: #fff;\n  box-shadow: 0 6px 16px rgb(50 50 50 / 5%);\n}\n\n.admin-dashboard__metric-icon {\n  display: grid;\n  width: 42px;\n  height: 42px;\n  place-items: center;\n  border-radius: 50%;\n  background: #dce9ff;\n  color: #2f68c9;\n  font-size: 1.7rem;\n  line-height: 1;\n}\n\n.admin-dashboard__metric strong {\n  color: #1b2942;\n  font-size: 2rem;\n  line-height: 1.1;\n}\n\n.admin-dashboard__metric > span:not(.admin-dashboard__metric-icon) {\n  color: #69768b;\n  font-size: .9rem;\n  line-height: 1.5;\n}\n\n.admin-dashboard__extended {\n  display: grid;\n  gap: 28px;\n  margin-block-start: 28px;\n}\n\n.admin-dashboard__extended-grid,\n.admin-dashboard__activity-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 18px;\n}\n\n.admin-dashboard__extended-section,\n.admin-dashboard__activity-panel,\n.admin-dashboard__quick-actions {\n  min-width: 0;\n  padding: 22px;\n  border: 1px solid #e3e5e7;\n  border-radius: 18px;\n  background: #fff;\n  box-shadow: 0 6px 16px rgb(50 50 50 / 5%);\n}\n\n.admin-dashboard__extended-section .admin-dashboard__section-heading,\n.admin-dashboard__activity-panel .admin-dashboard__section-heading,\n.admin-dashboard__quick-actions .admin-dashboard__section-heading {\n  margin-block-end: 18px;\n}\n\n.admin-dashboard__extended-section h2,\n.admin-dashboard__activity-panel h2,\n.admin-dashboard__quick-actions h2 {\n  margin-block-end: 0;\n}\n\n.admin-dashboard__metric-grid--compact {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.admin-dashboard__metric--unavailable {\n  min-height: 126px;\n  backgroun