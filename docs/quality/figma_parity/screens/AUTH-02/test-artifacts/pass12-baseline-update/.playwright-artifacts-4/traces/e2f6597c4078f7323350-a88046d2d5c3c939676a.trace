dding: 0;\n  color: var(--color-text-strong);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-semibold);\n}\n\n.auth-otp__digits {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(0, 1fr));\n  gap: clamp(var(--space-xs), 2vw, var(--space-md));\n}\n\n.auth-otp__digit {\n  inline-size: 100%;\n  min-block-size: clamp(3.25rem, 10vw, 5rem);\n  padding: var(--space-sm);\n  color: var(--color-text-strong);\n  background: var(--color-page-background);\n  border: 2px solid var(--color-brand-accent);\n  border-radius: var(--radius-lg);\n  font-size: clamp(var(--font-size-heading-two), 7vw, var(--font-size-display));\n  font-weight: var(--font-weight-bold);\n  line-height: 1;\n  text-align: center;\n}\n\n.auth-otp__digit:focus-visible {\n  border-color: var(--color-focus);\n}\n\n.auth-otp__digit[aria-invalid=\"true\"] {\n  border-color: var(--color-status-error);\n}\n\n.auth-otp__actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: var(--space-sm) var(--space-lg);\n}\n\n.auth-role-options {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--space-md);\n}\n\n.auth-role-card {\n  display: grid;\n  align-content: start;\n  gap: var(--space-sm);\n  min-block-size: 11rem;\n  padding: var(--space-lg);\n  color: var(--color-text-strong);\n  text-align: start;\n  background: var(--color-page-background);\n  border: 2px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  cursor: pointer;\n  font: inherit;\n  text-decoration: none;\n  transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;\n}\n\n.auth-role-card:hover {\n  border-color: var(--color-brand-accent);\n  transform: translateY(-1px);\n}\n\n.auth-role-card:focus-visible {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 3px;\n}\n\n.auth-role-card--selected {\n  background: color-mix(in srgb, var(--color-brand-accent) 12%, var(--color-page-background));\n  border-color: va