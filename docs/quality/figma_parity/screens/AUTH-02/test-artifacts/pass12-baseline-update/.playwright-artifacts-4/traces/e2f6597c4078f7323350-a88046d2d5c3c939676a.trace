.5rem;\n  --space-3xl: 3rem;\n  --space-4xl: 4rem;\n\n  --radius-sm: 0.5rem;\n  --radius-md: 0.75rem;\n  --radius-lg: 1rem;\n  --radius-xl: 1.5rem;\n  --radius-full: 9999px;\n\n  --shadow-sm: 0 1px 2px 0 rgb(23 35 61 / 0.05);\n  --shadow-card: 0 1px 3px 0 rgb(23 35 61 / 0.1), 0 1px 2px -1px rgb(23 35 61 / 0.1);\n  --shadow-dropdown: 0 10px 15px -3px rgb(23 35 61 / 0.1), 0 4px 6px -4px rgb(23 35 61 / 0.1);\n  --shadow-modal: 0 25px 50px -12px rgb(23 35 61 / 0.25);\n  --shadow-sticky: 0 20px 25px -5px rgb(23 35 61 / 0.1), 0 8px 10px -6px rgb(23 35 61 / 0.1);\n  --shadow-header: var(--shadow-sm);\n  --shadow-state: var(--shadow-card);\n\n  --button-height-xs: 1.75rem;\n  --button-height-sm: 2rem;\n  --button-height-md: 2.5rem;\n  --button-height-lg: 3rem;\n  --input-height: 2.5rem;\n  --header-height-min: 3.5rem;\n  --header-height-max: 4rem;\n  --sidebar-width: 15rem;\n  --modal-max-width-min: 30rem;\n  --modal-max-width-max: 37.5rem;\n\n  --asset-logo-max-inline-size: 4rem;\n  --asset-logo-max-block-size: 3.5rem;\n}\n.ui-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-sm);\n  min-block-size: var(--button-height-md);\n  padding-block: var(--space-sm);\n  padding-inline: var(--space-lg);\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-weight: var(--font-weight-semibold);\n  line-height: 1;\n  cursor: pointer;\n  transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, opacity 120ms ease;\n}\n\n.ui-button--xs {\n  min-block-size: var(--button-height-xs);\n  padding-block: var(--space-xs);\n  padding-inline: var(--space-sm);\n  font-size: var(--font-size-caption);\n}\n\n.ui-button--sm {\n  min-block-size: var(--button-height-sm);\n  padding-block: var(--space-xs);\n  padding-inline: var(--space-md);\n  font-size: var(--font-size-small);\n}\n\n.ui-button--lg {\n  min-block-size: var(--button-height-lg);\n  padding-block: var(--space-md);\n  padding-inline: var(--space-xl);\n}\n\n.ui-button--full {\n  inline-size: 100%;\n}\n\n.ui-button--primary {\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n}\n\n.ui-button--secondary {\n  color: var(--color-brand-secondary);\n  background: var(--color-surface);\n  border-color: var(--color-border-strong);\n}\n\n.ui-button--accent {\n  color: var(--color-brand-secondary);\n  background: var(--color-brand-accent);\n}\n\n.ui-button--ghost {\n  color: var(--color-brand-secondary);\n  background: transparent;\n  border-color: transparent;\n}\n\n.ui-button--danger {\n  color: var(--color-on-brand);\n  background: var(--color-status-error);\n}\n\n.ui-button--success {\n  color: var(--color-on-brand);\n  background: var(--color-status-success);\n}\n\n.ui-button:hover:not(:disabled) {\n  filter: brightness(0.96);\n}\n\n.ui-button:disabled,\n.ui-button[data-state=\"disabled\"] {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.ui-button__icon,\n.ui-button__spinner {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  justify-content: center;\n}\n\n.ui-button__spinner {\n  inline-size: 1em;\n  block-size: 1em;\n  border: 2px solid currentColor;\n  border-block-end-color: transparent;\n  border-radius: var(--radius-full);\n  animation: ui-spin 700ms linear infinite;\n}\n\n.ui-field {\n  display: grid;\n  gap: var(--space-xs);\n  inline-size: 100%;\n}\n\n.ui-field__label {\n  color: var(--color-text-strong);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-semibold);\n}\n\n.ui-field__control {\n  inline-size: 100%;\n  min-block-size: var(--input-height);\n  padding-block: var(--space-sm);\n  padding-inline: var(--space-md);\n  color: var(--color-text);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  font: inherit;\n}\n\n.ui-field__control::placeholder {\n  color: var(--color-text-muted);\n}\n\n.ui-field__control:focus-visible {\n  border-color: var(--color-focus);\n}\n\n.ui-field--error .ui-field__control {\n  border-color: var(--color-status-error);\n}\n\n.ui-field--success .ui-field__control {\n  border-color: var(--color-status-success);\n}\n\n.ui-field--disabled .ui-field__control,\n.ui-field__control:disabled {\n  color: var(--color-text-muted);\n  background: var(--color-page-background);\n  cursor: not-allowed;\n}\n\n.ui-field__select {\n  cursor: pointer;\n}\n\n.ui-field__message {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.ui-field__message[data-tone=\"error\"] {\n  color: var(--color-status-error);\n}\n\n.ui-field__message[data-tone=\"success\"] {\n  color: var(--color-status-success);\n}\n\n.ui-tabs {\n  display: grid;\n  gap: var(--space-lg);\n}\n\n.ui-tabs__list {\n  display: flex;\n  gap: var(--space-xs);\n  overflow-inline: auto;\n  border-block-end: 1px solid var(--color-border);\n}\n\n.ui-tabs__tab {\n  flex: 0 0 auto;\n  min-block-size: var(--button-height-md);\n  padding-block: var(--space-sm);\n  padding-inline: var(--space-md);\n  color: var(--color-text-secondary);\n  background: transparent;\n  border: 0;\n  border-block-end: 2px solid transparent;\n  font: inherit;\n  cursor: pointer;\n}\n\n.ui-tabs__tab[aria-selected=\"true\"] {\n  color: var(--color-brand-primary);\n  border-block-end-color: var(--color-brand-accent);\n  font-weight: var(--font-weight-semibold);\n}\n\n.ui-tabs__tab:disabled {\n  color: var(--color-text-muted);\n  cursor: not-allowed;\n}\n\n.ui-tabs__panel {\n  min-inline-size: 0;\n}\n\n.ui-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-xs);\n  min-block-size: 1.5rem;\n  padding-block: var(--space-xs);\n  padding-inline: var(--space-sm);\n  border-radius: var(--radius-full);\n  font-size: var(--font-size-caption);\n  font-weight: var(--font-weight-semibold);\n  line-height: 1;\n}\n\n.ui-badge--neutral {\n  color: var(--color-text-secondary);\n  background: var(--color-page-background);\n}\n\n.ui-badge--brand {\n  color: var(--color-brand-primary);\n  background: var(--color-brand-soft);\n}\n\n.ui-badge--gold {\n  color: var(--color-brand-secondary);\n  background: var(--color-brand-accent);\n}\n\n.ui-badge--info {\n  color: var(--color-brand-secondary);\n  background: color-mix(in srgb, var(--color-status-info) 18%, var(--color-surface));\n}\n\n.ui-badge--success {\n  color: var(--color-brand-primary);\n  background: color-mix(in srgb, var(--color-status-success) 18%, var(--color-surface));\n}\n\n.ui-badge--warning {\n  color: var(--color-brand-secondary);\n  background: color-mix(in srgb, var(--color-status-warning) 20%, var(--color-surface));\n}\n\n.ui-badge--error {\n  color: var(--color-status-error);\n  background: color-mix(in srgb, var(--color-status-error) 14%, var(--color-surface));\n}\n\n.ui-badge__dot {\n  inline-size: 0.45rem;\n  block-size: 0.45rem;\n  background: currentColor;\n  border-radius: var(--radius-full);\n}\n\n.ui-state-message {\n  display: grid;\n  gap: var(--space-sm);\n  padding: var(--space-xl);\n  color: var(--color-text-secondary);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n}\n\n.ui-state-message h3,\n.ui-state-message p {\n  margin: 0;\n}\n\n.ui-state-message h3 {\n  color: var(--color-text-strong);\n  font-size: var(--font-size-section-title);\n}\n\n.ui-state-message[data-state=\"error\"],\n.ui-state-message[data-state=\"permission\"] {\n  border-color: var(--color-status-error);\n}\n\n.ui-state-message[data-state=\"success\"] {\n  border-color: var(--color-status-success);\n}\n\n.ui-state-message[data-state=\"retry\"] {\n  border-color: var(--color-status-warning);\n}\n\n.ui-state-message[data-state=\"loading\"] {\n  border-color: var(--color-status-info);\n}\n\n.ui-modal-backdrop {\n  position: fixed;\n  z-index: 20;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: var(--space-xl);\n  background: color-mix(in srgb, var(--color-brand-secondary) 55%, transparent);\n}\n\n.ui-modal {\n  inline-size: min(100%, var(--modal-max-width-max));\n  max-block-size: calc(100vh - var(--space-4xl));\n  overflow: auto;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-modal);\n}\n\n.ui-modal__header,\n.ui-modal__footer {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-lg);\n  padding: var(--space-xl);\n}\n\n.ui-modal__header {\n  border-block-end: 1px solid var(--color-border);\n}\n\n.ui-modal__header h2,\n.ui-modal__header p {\n  margin: 0;\n}\n\n.ui-modal__header h2 {\n  color: var(--color-text-strong);\n  font-size: var(--font-size-heading-two);\n}\n\n.ui-modal__header p {\n  margin-block-start: var(--space-xs);\n  color: var(--color-text-secondary);\n}\n\n.ui-modal__close,\n.ui-toast__dismiss {\n  flex: 0 0 auto;\n  inline-size: var(--button-height-sm);\n  block-size: var(--button-height-sm);\n  color: var(--color-text-secondary);\n  background: transparent;\n  border: 0;\n  border-radius: var(--radius-md);\n  font: inherit;\n  font-size: var(--font-size-heading-two);\n  line-height: 1;\n  cursor: pointer;\n}\n\n.ui-modal__body {\n  padding: var(--space-xl);\n}\n\n.ui-modal__footer {\n  align-items: center;\n  justify-content: flex-end;\n  border-block-start: 1px solid var(--color-border);\n}\n\n.ui-toast {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-lg);\n  inline-size: min(100%, 28rem);\n  padding: var(--space-lg);\n  color: var(--color-text-strong);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-inline-start: 4px solid var(--color-status-info);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-card);\n}\n\n.ui-toast[data-tone=\"success\"] {\n  border-inline-start-color: var(--color-status-success);\n}\n\n.ui-toast[data-tone=\"warning\"] {\n  border-inline-start-color: var(--color-status-warning);\n}\n\n.ui-toast[data-tone=\"error\"] {\n  border-inline-start-color: var(--color-status-error);\n}\n\n.ui-toast__content {\n  display: grid;\n  gap: var(--space-xs);\n}\n\n.ui-toast__content p {\n  margin: 0;\n  color: var(--color-text-secondary);\n}\n\n.ui-table-wrap {\n  inline-size: 100%;\n  overflow-inline: auto;\n}\n\n.ui-table {\n  inline-size: 100%;\n  border-collapse: collapse;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n}\n\n.ui-table caption {\n  margin-block-end: var(--space-sm);\n  color: var(--color-text-strong);\n  font-weight: var(--font-weight-semibold);\n  text-align: start;\n}\n\n.ui-table th,\n.ui-table td {\n  padding-block: var(--space-md);\n  padding-inline: var(--space-lg);\n  border-block-end: 1px solid var(--color-border);\n  text-align: start;\n  vertical-align: middle;\n}\n\n.ui-table th {\n  color: var(--color-text-strong);\n  background: var(--color-surface-soft);\n  font-size: var(--font-size-small);\n}\n\n.ui-table td {\n  color: var(--color-text-secondary);\n}\n\n.ui-table [data-align=\"center\"] {\n  text-align: center;\n}\n\n.ui-table [data-align=\"end\"] {\n  text-align: end;\n}\n\n.ui-table tr:last-child td {\n  border-block-end: 0;\n}\n\n.ui-pagination {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-sm);\n}\n\n.ui-pagination__pages {\n  display: flex;\n  align-items: center;\n  gap: var(--space-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.ui-pagination__page {\n  inline-size: var(--button-height-md);\n  block-size: var(--button-height-md);\n  color: var(--color-text-secondary);\n  background: transparent;\n  border: 1px solid transparent;\n  border-radius: var(--radius-md);\n  font: inherit;\n  cursor: pointer;\n}\n\n.ui-pagination__page[aria-current=\"page\"] {\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n}\n\n.ui-pagination__ellipsis {\n  color: var(--color-text-muted);\n}\n\n.ui-property-card {\n  display: grid;\n  overflow: hidden;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-card);\n}\n\n.ui-property-card__media {\n  display: grid;\n  place-items: center;\n  min-block-size: 12rem;\n  overflow: hidden;\n  background: var(--color-surface-soft);\n}\n\n.ui-property-card__media > img {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n  object-fit: cover;\n}\n\n.ui-property-card__media--empty {\n  background: var(--color-surface-soft);\n}\n\n.ui-property-card__body {\n  display: grid;\n  gap: var(--space-sm);\n  padding: var(--space-lg);\n}\n\n.ui-property-card__body h3,\n.ui-property-card__location,\n.ui-property-card__price,\n.ui-property-card__source {\n  margin: 0;\n}\n\n.ui-property-card__title {\n  color: var(--color-text-strong);\n  font-size: var(--font-size-section-title);\n  font-weight: var(--font-weight-bold);\n  text-decoration: none;\n}\n\n.ui-property-card__location,\n.ui-property-card__source {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.ui-property-card__price {\n  color: var(--color-brand-accent);\n  font-size: var(--font-size-body-large);\n  font-weight: var(--font-weight-bold);\n}\n\n.ui-property-card__badges,\n.ui-property-card__action {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-xs);\n}\n\n.ui-property-card__features {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--space-sm);\n  margin: 0;\n  padding-block: var(--space-sm);\n  border-block: 1px solid var(--color-border);\n}\n\n.ui-property-card__features div {\n  display: grid;\n  gap: var(--space-xs);\n}\n\n.ui-property-card__features dt {\n  color: var(--color-text-muted);\n  font-size: var(--font-size-caption);\n}\n\n.ui-property-card__features dd {\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-semibold);\n}\n\n@keyframes ui-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .ui-button {\n    transition: none;\n  }\n\n  .ui-button__spinner {\n    animation-duration: 1.5s;\n  }\n}\n.route-shell__header {\n  flex-wrap: wrap;\n}\n\n.route-shell__body {\n  display: grid;\n  grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr);\n  align-items: start;\n  min-height: calc(100vh - var(--header-height-min));\n}\n\n.route-shell__navigation {\n  min-height: 100%;\n  padding: var(--space-xl);\n  color: var(--color-text-strong);\n  background: var(--color-surface);\n  border-inline-end: 1px solid var(--color-border);\n}\n\n.route-shell__navigation-label {\n  display: block;\n  font-weight: var(--font-weight-strong);\n}\n\n.route-shell__body .app-main {\n  width: min(calc(100% - var(--space-2xl)), 64rem);\n}\n\n.route-status-page {\n  display: grid;\n  gap: var(--space-sm);\n}\n\n.route-status-page__code {\n  margin: 0;\n  color: var(--color-accent-text);\n  font-size: var(--font-size-heading-two);\n  font-weight: var(--font-weight-strong);\n}\n\n.route-status-page__requested-route {\n  overflow-wrap: anywhere;\n}\n\n.route-status-page a {\n  color: var(--color-brand-interactive);\n  font-weight: var(--font-weight-strong);\n}\n.a11y-skip-link {\n  position: fixed;\n  z-index: 100;\n  inset-block-start: var(--space-sm);\n  inset-inline-start: var(--space-sm);\n  transform: translateY(-200%);\n  padding-block: var(--space-sm);\n  padding-inline: var(--space-md);\n  color: var(--color-text-strong);\n  background: var(--color-surface);\n  border: 2px solid var(--color-brand-secondary);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-card);\n  font-weight: var(--font-weight-semibold);\n  text-decoration: none;\n}\n\n.a11y-skip-link:focus-visible {\n  transform: translateY(0);\n}\n\n.a11y-visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n#main-content {\n  scroll-margin-block-start: var(--space-2xl);\n}\n\n:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {\n  outline: 3px solid var(--color-brand-secondary);\n  outline-offset: 3px;\n  box-shadow: 0 0 0 6px var(--color-surface);\n}\n\n/* Keep semantic action cues while moving button text onto an approved high-contrast surface. */\n.ui-button--danger,\n.ui-button--success {\n  color: var(--color-text-strong);\n  background: var(--color-surface);\n}\n\n.ui-button--danger {\n  border-color: var(--color-status-error);\n}\n\n.ui-button--success {\n  border-color: var(--color-status-success);\n}\n\n.ui-badge--error {\n  color: var(--color-text-strong);\n  border: 1px solid var(--color-status-error);\n}\n\n.ui-field__message[data-tone=\"error\"] {\n  color: var(--color-text-strong);\n  border-inline-start: 3px solid var(--color-status-error);\n  padding-inline-start: var(--space-sm);\n}\n\n.ui-property-card__price,\n.route-status-page__code,\ncode {\n  color: var(--color-text-strong);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    scroll-behavior: auto !important;\n    transition-duration: 0.001ms !important;\n  }\n}\n\n@media (prefers-contrast: more) {\n  :root {\n    --color-border: var(--color-border-strong);\n  }\n\n  :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {\n    outline-width: 4px;\n  }\n}\n\n:root {\n  color: var(--color-text);\n  background: var(--color-page-background);\n  font-family: var(--font-family-sans);\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  min-width: 320px;\n  min-height: 100vh;\n  margin: 0;\n  background: var(--color