ck;\n  margin: 0 0 10px;\n  color: #7184a8;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.provider-dashboard__navigation-title {\n  padding: 0 12px 18px;\n  color: #b9c8e2;\n}\n\n.provider-dashboard__navigation ul {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.provider-dashboard__navigation a {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-height: 46px;\n  padding: 10px 12px;\n  border-radius: 12px;\n  color: #d9e4f7;\n  font-size: 0.92rem;\n  text-decoration: none;\n}\n\n.provider-dashboard__navigation a:hover,\n.provider-dashboard__navigation a:focus-visible,\n.provider-dashboard__navigation a[data-active='true'] {\n  background: rgb(255 255 255 / 12%);\n  color: #fff;\n}\n\n.provider-dashboard__navigation a:focus-visible,\n.provider-dashboard__primary-action:focus-visible,\n.provider-dashboard__secondary-action:focus-visible,\n.provider-dashboard__property-row a:focus-visible {\n  outline: 3px solid #89b4ff;\n  outline-offset: 3px;\n}\n\n.provider-dashboard__navigation-icon {\n  display: inline-grid;\n  width: 24px;\n  place-items: center;\n  color: #9bb5e4;\n  font-size: 1.15rem;\n}\n\n.provider-dashboard__content {\n  min-width: 0;\n  padding: 42px clamp(24px, 4vw, 64px);\n  background: #f7f9fc;\n}\n\n.provider-dashboard__heading-row,\n.provider-dashboard__section-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 24px;\n}\n\n.provider-dashboard__heading-row {\n  margin-bottom: 34px;\n}\n\n.provider-dashboard h1,\n.provider-dashboard h2,\n.provider-dashboard h3,\n.provider-dashboard p {\n  margin-top: 0;\n}\n\n.provider-dashboard h1 {\n  margin-bottom: 12px;\n  color: #1b2942;\n  font-size: clamp(2rem, 3vw, 3rem);\n  letter-spacing: -0.03em;\n}\n\n.provider-dashboard h2 {\n  margin-bottom: 18px;\n  color: #24334f;\n  font-size: 1.2rem;\n}\n\n.provider-dashboard__heading-row p:not(.provider-dash