grid; gap: 12px; margin: 20px 0; padding: 18px; border: 1px solid #e0e7f1; border-radius: 12px; }\n.provider-property-completion__checks legend { padding: 0 6px; color: #33435e; font-weight: 800; }\n.provider-property-completion__checks label { display: flex; gap: 10px; align-items: flex-start; color: #33435e; line-height: 1.5; }\n.provider-property-completion__checks input { width: 18px; height: 18px; flex: 0 0 18px; accent-color: #2f68c9; }\n\n.provider-property-completion button:focus-visible,\n.provider-property-completion select:focus-visible,\n.provider-property-completion textarea:focus-visible { outline: 3px solid #89b4ff; outline-offset: 3px; }\n\n.provider-property-state__state {\n  max-width: 680px;\n  margin: 48px auto;\n  padding: 30px;\n  border: 1px solid #e0e7f1;\n  border-radius: 18px;\n  background: #fff;\n  text-align: center;\n}\n\n.provider-property-state__state > button { margin-top: 16px; }\n\n.provider-property-state__main {\n  max-width: 880px;\n  margin: 0 auto;\n}\n\n.provider-property-state__intro { text-align: center; }\n.provider-property-state__intro h1 { margin: 8px 0 10px; color: #17233f; font-size: clamp(1.8rem, 3vw, 2.7rem); }\n.provider-property-state__intro > p:last-child { margin: 0 auto; max-width: 720px; color: #71809a; line-height: 1.7; }\n\n.provider-property-state__card,\n.provider-property-state__notice,\n.provider-property-state__safe {\n  margin-top: 24px;\n  padding: 24px;\n  border: 1px solid #e0e7f1;\n  border-radius: 16px;\n  background: #fff;\n}\n\n.provider-property-state__card h2,\n.provider-property-state__notice h2,\n.provider-property-state__safe h2 { margin: 0 0 12px; color: #24334f; }\n.provider-property-state__summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 20px; margin: 0; }\n.provider-property-state__summary div { padding: 14px; border-radius: 10px; background: #f7f9fc; }\n.provider-property-state__summary dt { color: #71809a; font-size: 0.82rem; }\n.provider-property-state__summary dd { margin: 5px 0 0; color: #24334f; font-weight: 750; overflow-wrap: anywhere; }\n\n.provider-property-state__notice { border-color: #ffe1a6; background: #fffaf0; color: #8b4e0b; }\n.provider-property-state__notice--rejected,\n.provider-property-state__notice--validation { border-color: #f5c2c7; background: #fff4f5; color: #8c2838; }\n.provider-property-state__notice--published { border-color: #b8ebce; background: #f1fbf5; color: #287457; }\n.provider-property-state__notice p,\n.provider-property-state__safe p { margin: 0; line-height: 1.7; }\n.provider-property-state__notice ul { margin: 0 0 16px; padding-inline-start: 22px; line-height: 1.8; }\n.provider-property-state__notice p strong { color: inherit; }\n\n.provider-property-state__safe { border-style: dashed; color: #586981; }\n.provider-property-state__safe h2 { font-size: 1rem; }\n.provider-property-state__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 26px; }\n.provider-property-state__actions > a,\n.provider-property-state__actions > button { min-width: 210px; justify-content: center; text-align: center; }\n.provider-property-state__unavailable { margin: 18px 0 0; color: #71809a; font-size: 0.9rem; text-align: center; }\n\n.provider-property-validation .provider-property-state__card { margin-top: 20px; }\n.provider-property-validation .provider-property-state__safe { margin-top: 20px; }\n\n@media (max-width: 900px) {\n  .provider-property-wizard__grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .provider-property-wizard__steps li:not(:last-child)::after {\n    width: 20px;\n  }\n\n  .provider-property-completion__steps,\n  .provider-property-completion__summary { grid-template-columns: minmax(0, 1fr); }\n\n  .provider-property-completion__steps { display: grid; }\n  .provider-property-completion__media-item { align-items: flex-start; flex-direction: column; }\n  .provider-property-completion__item-actions { justify-content: flex-start; }\n  .provider-property-state__summary { grid-template-columns: minmax(0, 1fr); }\n  .provider-property-state__actions { align-items: stretch; flex-direction: column; }\n  .provider-property-state__actions > a,\n  .provider-property-state__actions > button { width: 100%; }\n}\n"],["STYLE",{},".route-shell--seeker .route-shell__navigation {\n  display: none;\n}\n\n.route-shell--seeker .route-shell__body {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.route-shell--seeker .app-main {\n  width: min(calc(100% - 3rem), 112rem);\n  padding-block: 0;\n}\n\n.seeker-dashboard {\n  display: grid;\n  grid-template-columns: minmax(15rem, 18rem) minmax(0, 1fr);\n  min-height: calc(100vh - var(--header-height-min));\n  background: var(--color-surface-soft);\n  color: var(--color-text);\n}\n\n.seeker-dashboard__nav {\n  padding: var(--space-3xl) var(--space-xl);\n  background: var(--color-surface);\n  border-inline-end: 1px solid var(--color-border);\n}\n\n.seeker-dashboard__nav-title,\n.seeker-dashboard__eyebrow {\n  display: block;\n  color: var(--color-brand);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-bold);\n  letter-spacing: var(--letter-spacing-label);\n  text-transform: uppercase;\n}\n\n.seeker-dashboard__nav ul {\n  display: grid;\n  gap: var(--space-sm);\n  margin: var(--space-2xl) 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.seeker-dashboard__nav a {\n  display: flex;\n  align-items: center;\n  gap: var(--space-md);\n  min-block-size: 3rem;\n  padding: var(--space-md);\n  color: var(--color-text-secondary);\n  border-radius: var(--radius-md);\n  text-decoration: none;\n}\n\n.seeker-dashboard__nav a:hover,\n.seeker-dashboard__nav a[data-active=\"true\"] {\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n}\n\n.seeker-dashboard__nav-icon {\n  inline-size: 1.5rem;\n  color: var(--color-accent-text);\n  font-size: 1.35rem;\n  text-align: center;\n}\n\n.seeker-dashboard__content {\n  min-width: 0;\n  padding: clamp(var(--space-xl), 4vw, var(--space-4xl));\n}\n\n.seeker-dashboard__heading-row,\n.seeker-dashboard__section-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-xl);\n}\n\n.seeker-dashboard__heading-row h1 {\n  max-width: 52rem;\n  margin: var(--space-sm) 0;\n  color: var(--color-text-strong);\n  font-size: clamp(2rem, 4vw, 3.5rem);\n  line-height: var(--line-height-display);\n}\n\n.seeker-dashboard__heading-row p:last-child {\n  max-width: 48rem;\n  margin: 0;\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-body-large);\n}\n\n.seeker-dashboard__primary-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-sm);\n  flex: 0 0 auto;\n  min-block-size: 3.25rem;\n  padding: var(--space-md) var(--space-xl);\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n  border-radius: var(--radius-xl);\n  font-weight: var(--font-weight-bold);\n  text-decoration: none;\n}\n\n.seeker-dashboard__summary,\n.seeker-dashboard__activity {\n  margin-block-start: clamp(var(--space-2xl), 5vw, var(--space-4xl));\n}\n\n.seeker-dashboard__section-heading {\n  align-items: center;\n  margin-block-end: var(--space-lg);\n}\n\n.seeker-dashboard__section-heading h2 {\n  margin: 0;\n  color: var(--color-text-strong);\n  font-size: var(--font-size-heading-two);\n}\n\n.seeker-dashboard__summary-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--space-lg);\n}\n\n.seeker-dashboard__summary-card {\n  display: grid;\n  gap: var(--space-md);\n  min-block-size: 10rem;\n  padding: var(--space-xl);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-card);\n}\n\n.seeker-dashboard__summary-icon {\n  display: grid;\n  place-items: center;\n  inline-size: 3.25rem;\n  block-size: 3.25rem;\n  border-radius: 50%;\n  color: var(--color-brand-primary);\n  background: var(--color-brand-soft);\n  font-size: 1.75rem;\n}\n\n.seeker-dashboard__summary-card strong {\n  color: var(--color-text-strong);\n  font-size: clamp(2rem, 4vw, 3rem);\n  line-height: 1;\n}\n\n.seeker-dashboard__summary-card > span:last-child {\n  color: var(--color-text-secondary);\n}\n\n.seeker-dashboard__activity > .seeker-dashboard__section-heading {\n  margin-block-end: 0;\n}\n\n.seeker-dashboard__empty,\n.seeker-dashboard__unavailable,\n.seeker-dashboard__state {\n  margin-block-start: var(--space-lg);\n  padding: clamp(var(--space-xl), 4vw, var(--space-3xl));\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-card);\n}\n\n.seeker-dashboard__empty {\n  box-sizing: border-box;\n  width: 100%;\n}\n\n.seeker-dashboard__empty h2 {\n  margin-block-start: 0;\n  color: var(--color-text-strong);\n}\n\n.seeker-dashboard__empty h3,\n.seeker-dashboard__unavailable h3 {\n  margin-block-start: 0;\n  color: var(--color-text-strong);\n}\n\n.seeker-dashboard__empty p,\n.seeker-dashboard__unavailable p {\n  margin-block-end: 0;\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-body);\n}\n\n.seeker-dashboard__activity-note {\n  padding-block-start: var(--space-lg);\n  border-block-start: 1px solid var(--color-border);\n}\n\n.seeker-dashboard__state .ui-state-message {\n  margin-block-start: 0;\n}\n\n@media (max-width: 900px) {\n  .seeker-dashboard {\n    grid-template-columns: 1fr;\n  }\n\n  .seeker-dashboard__nav {\n    padding: var(--space-lg);\n    border-inline-end: 0;\n    border-block-end: 1px solid var(--color-border);\n  }\n\n  .seeker-dashboard__nav ul {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    margin-block-start: var(--space-lg);\n  }\n\n  .seeker-dashboard__nav a {\n    justify-content: center;\n    min-block-size: 2.75rem;\n    padding: var(--space-sm);\n    text-align: center;\n  }\n\n  .seeker-dashboard__nav a span:last-child {\n    display: none;\n  }\n\n  .seeker-dashboard__summary-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 640px) {\n  .route-shell--seeker .app-main {\n    width: 100%;\n  }\n\n  .seeker-dashboard__content {\n    padding: var(--space-xl);\n  }\n\n  .seeker-dashboard__heading-row {\n    display: grid;\n  }\n\n  .seeker-dashboard__primary-link {\n    justify-self: start;\n  }\n\n  .seeker-dashboard__nav ul {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n\n  .seeker-dashboard__summary-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.seeker-requests__panel {\n  margin-block-start: var(--space-3xl);\n  padding: var(--space-xl);\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-card);\n}\n\n.seeker-requests__count {\n  color: var(--color-text-secondary);\n  font-weight: var(--font-weight-bold);\n}\n\n.seeker-requests__toolbar {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: var(--space-xl);\n  margin-block-end: var(--space-lg);\n}\n\n.seeker-requests__toolbar .ui-field {\n  flex: 1 1 28rem;\n  max-inline-size: 34rem;\n}\n\n.seeker-requests__toolbar .seeker-requests__count {\n  flex: 0 0 auto;\n  padding-block-end: var(--space-sm);\n}\n\n.seeker-requests__filters {\n  display: flex;\n  gap: var(--space-sm);\n  margin-block-end: var(--space-xl);\n  overflow-x: auto;\n  padding-block-end: var(--space-xs);\n}\n\n.seeker-requests__filter {\n  min-block-size: 2.6rem;\n  padding: var(--space-sm) var(--space-lg);\n  color: var(--color-text-secondary);\n  white-space: nowrap;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 999px;\n  font: inherit;\n  font-weight: var(--font-weight-bold);\n  cursor: pointer;\n}\n\n.seeker-requests__filter:hover,\n.seeker-requests__filter:focus-visible,\n.seeker-requests__filter[data-active=\"true\"] {\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n  border-color: var(--color-brand-primary);\n}\n\n.seeker-requests__list {\n  overflow: hidden;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n}\n\n.seeker-requests__columns,\n.seeker-request-row {\n  display: grid;\n  grid-template-columns: minmax(14rem, 1.5fr) minmax(9rem, 1fr) minmax(9rem, 1fr) minmax(8rem, .75fr);\n  align-items: center;\n  gap: var(--space-lg);\n  padding: var(--space-lg) var(--space-xl);\n}\n\n.seeker-requests__columns {\n  color: var(--color-text-secondary);\n  background: var(--color-surface-soft);\n  font-size: var(--font-size-small);\n  font-weight: var(--font-weight-bold);\n}\n\n.seeker-request-row {\n  min-block-size: 6.5rem;\n  border-block-start: 1px solid var(--color-border);\n}\n\n.seeker-request-row__identity {\n  display: flex;\n  align-items: center;\n  gap: var(--space-md);\n  min-width: 0;\n}\n\n.seeker-request-row__identity > div {\n  display: grid;\n  gap: var(--space-xs);\n}\n\n.seeker-request-row__identity strong {\n  color: var(--color-text-strong);\n  letter-spacing: .04em;\n}\n\n.seeker-request-row__identity span:not(.seeker-request-row__icon) {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.seeker-request-row__icon {\n  display: grid;\n  place-items: center;\n  inline-size: 2.75rem;\n  block-size: 2.75rem;\n  flex: 0 0 auto;\n  color: var(--color-brand-primary);\n  background: var(--color-brand-soft);\n  border-radius: 50%;\n  font-size: 1.35rem;\n}\n\n.seeker-request-row time {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.seeker-request-row__details,\n.seeker-dashboard__back-link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: var(--space-sm);\n  color: var(--color-brand-primary);\n  font-weight: var(--font-weight-bold);\n  text-decoration: none;\n}\n\n.seeker-request-row__details:hover,\n.seeker-dashboard__back-link:hover {\n  text-decoration: underline;\n}\n\n.seeker-request-detail {\n  display: grid;\n  gap: var(--space-2xl);\n}\n\n.seeker-request-detail__id {\n  color: var(--color-text-secondary);\n  font-size: .55em;\n  letter-spacing: .06em;\n  white-space: nowrap;\n}\n\n.seeker-request-detail__grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.5fr) minmax(19rem, 1fr);\n  gap: var(--space-xl);\n}\n\n.seeker-request-detail__card {\n  min-width: 0;\n  padding: clamp(var(--space-xl), 3vw, var(--space-3xl));\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-card);\n}\n\n.seeker-request-detail__card h2 {\n  margin-block-start: 0;\n  color: var(--color-text-strong);\n  font-size: var(--font-size-heading-two);\n}\n\n.seeker-request-detail__timeline {\n  display: grid;\n  gap: var(--space-lg);\n  margin: var(--space-2xl) 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.seeker-request-detail__timeline li {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-md);\n}\n\n.seeker-request-detail__timeline li > span {\n  display: grid;\n  place-items: center;\n  inline-size: 2.5rem;\n  block-size: 2.5rem;\n  flex: 0 0 auto;\n  color: var(--color-on-brand);\n  background: var(--color-brand-primary);\n  border-radius: 50%;\n}\n\n.seeker-request-detail__timeline li[data-state=\"current\"] > span {\n  color: var(--color-brand-primary);\n  background: var(--color-brand-soft);\n  border: 2px solid var(--color-accent-text);\n}\n\n.seeker-request-detail__timeline li[data-state=\"pending\"] > span {\n  color: var(--color-text-secondary);\n  background: var(--color-surface);\n  border: 2px solid var(--color-border);\n}\n\n.seeker-request-detail__timeline li[data-state=\"pending\"] strong {\n  color: var(--color-text-secondary);\n}\n\n.seeker-request-detail__timeline li > div {\n  display: grid;\n  gap: var(--space-xs);\n}\n\n.seeker-request-detail__timeline time {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.seeker-request-detail__muted {\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-body);\n}\n\n.seeker-request-detail__values {\n  display: grid;\n  gap: var(--space-lg);\n  margin: var(--space-2xl) 0 0;\n}\n\n.seeker-request-detail__value {\n  display: flex;\n  justify-content: space-between;\n  gap: var(--space-lg);\n  padding-block-end: var(--space-md);\n  border-block-end: 1px solid var(--color-border);\n}\n\n.seeker-request-detail__value dt {\n  color: var(--color-text-secondary);\n}\n\n.seeker-request-detail__value dd {\n  margin: 0;\n  color: var(--color-text-strong);\n  font-weight: var(--font-weight-bold);\n  text-align: end;\n}\n\n.seeker-request-detail__payload {\n  margin-block-start: var(--space-xl);\n  padding: var(--space-lg);\n  background: var(--color-surface-soft);\n  border-radius: var(--radius-lg);\n}\n\n.seeker-request-detail__payload h3 {\n  margin-block: 0 var(--space-sm);\n  color: var(--color-text-strong);\n  font-size: var(--font-size-body);\n}\n\n.seeker-request-detail__payload p {\n  margin: 0;\n  color: var(--color-text-secondary);\n  line-height: var(--line-height-body);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.seeker-dashboard__back-link {\n  justify-self: start;\n}\n\n@media (max-width: 900px) {\n  .seeker-requests__toolbar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .seeker-requests__toolbar .ui-field {\n    max-inline-size: none;\n  }\n\n  .seeker-requests__columns,\n  .seeker-request-row {\n    grid-template-columns: minmax(12rem, 1.4fr) minmax(8rem, 1fr) minmax(8rem, 1fr);\n  }\n\n  .seeker-requests__columns span:last-child,\n  .seeker-request-row__details {\n    grid-column: 1 / -1;\n  }\n\n  .seeker-request-detail__grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.seeker-viewings__heading-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: var(--space