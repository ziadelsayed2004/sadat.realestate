ar(--space-md);\n  color: var(--color-brand-primary);\n  font-weight: var(--font-weight-semibold);\n}\n\n.public-developer-directory__state button {\n  padding: var(--space-sm) var(--space-md);\n  background: var(--color-surface);\n  border: 1px solid var(--color-brand-primary);\n  border-radius: var(--radius-md);\n  cursor: pointer;\n}\n\n.public-developer-profile__content {\n  padding-block: clamp(var(--space-2xl), 6vw, var(--space-4xl));\n}\n\n.public-developer-profile__back {\n  display: inline-flex;\n  margin-block-end: var(--space-xl);\n}\n\n.public-developer-profile__hero {\n  display: grid;\n  grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);\n  overflow: hidden;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-card);\n}\n\n.public-developer-profile__hero-body {\n  display: grid;\n  align-content: center;\n  gap: var(--space-md);\n  padding: clamp(var(--space-xl), 4vw, var(--space-3xl));\n}\n\n.public-developer-profile__hero-body p {\n  margin: 0;\n}\n\n.public-developer-profile__hero-description {\n  max-width: 55rem;\n  color: var(--color-text-secondary);\n}\n\n.public-developer-profile__badges .ui-badge {\n  font-size: var(--font-size-small);\n}\n\n.public-developer-profile__facts {\n  margin: 0;\n}\n\n.public-developer-profile__fact {\n  min-inline-size: 8rem;\n  padding: var(--space-md);\n  background: var(--color-page-background);\n  border-radius: var(--radius-md);\n}\n\n.public-developer-profile__fact dt,\n.public-developer-profile__fact dd {\n  margin: 0;\n}\n\n.public-developer-profile__fact dt {\n  color: var(--color-text-secondary);\n  font-size: var(--font-size-small);\n}\n\n.public-developer-profile__fact dd {\n  margin-block-start: var(--space-xs);\n  color: var(--color-text-strong);\n  font-size: var(--font-size-heading-three);\n  font-weight: var(--font-weight-bold);\n}\n\n.public-developer-profile__tabs {\n  margin-block: var(--space-2xl)