;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 2rem;\n  margin-bottom: 1.5rem;\n}\n\n.admin-properties__heading h1,\n.admin-properties__review-heading h1 {\n  margin: 0;\n  font-size: clamp(2rem, 3.4vw, 3.75rem);\n  line-height: 1.05;\n}\n\n.admin-properties__heading p,\n.admin-properties__review-heading p {\n  max-width: 58rem;\n  margin: 0.7rem 0 0;\n  color: var(--color-text-muted, #6b7280);\n}\n\n.admin-properties__eyebrow {\n  margin: 0 0 0.45rem !important;\n  color: var(--color-text-muted, #7f8798) !important;\n  font-size: 0.88rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.admin-properties__direction-note {\n  color: var(--color-text-muted, #7f8798);\n  font-size: 0.9rem;\n  white-space: nowrap;\n}\n\n.admin-properties__filters {\n  display: grid;\n  grid-template-columns: minmax(12rem, 1.7fr) minmax(9rem, 1fr) minmax(8rem, 0.8fr) minmax(11rem, 1fr) minmax(11rem, 1fr) auto auto;\n  align-items: end;\n  gap: 0.75rem;\n  margin-bottom: 1.5rem;\n  padding: 1rem;\n  border: 1px solid rgba(20, 33, 61, 0.08);\n  border-radius: 1.25rem;\n  background: rgba(255, 255, 255, 0.82);\n  box-shadow: 0 0.5rem 1.5rem rgba(20, 33, 61, 0.06);\n}\n\n.admin-properties__filters--reports {\n  grid-template-columns: minmax(12rem, 1fr) minmax(15rem, 1.4fr) auto auto;\n}\n\n.admin-properties__filters label,\n.admin-properties__field {\n  color: var(--color-text-muted, #6b7280);\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.admin-properties__filters input,\n.admin-properties__filters select,\n.admin-properties__action-card input,\n.admin-properties__action-card select,\n.admin-properties__action-card textarea {\n  width: 100%;\n  min-height: 2.8rem;\n  padding: 0.65rem 0.8rem;\n  border: 1px solid rgba(20, 33, 61, 0.16);\n  border-radius: 0.8rem;\n  background: #fff;\n  color: inherit;\n  font: inherit;\n}\n\n.admin-properties__filters input,\n.admin-properties__filters select {\n  grid-row: 2;\n}\n\n.admin-properties__filters label {\n  grid-row: 1;\n}\n\n.admin-properties__filters button {\n  grid-row: 2;\n}\n\n.admin-properties__panel,\n.admin-properties__detail-card,\n.admin-properties__action-card,\n.admin-properties__candidate,\n.admin-properties__report-detail {\n  border: 1px solid rgba(20, 33, 61, 0.1);\n  border-radius: 1.35rem;\n  background: rgba(255, 255, 255, 0.94);\n  box-shadow: 0 0.55rem 1.4rem rgba(20, 33, 61, 0.06);\n}\n\n.admin-properties__panel {\n  overflow: hidden;\n}\n\n.admin-properties__panel-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 1.15rem 1.35rem;\n  border-bottom: 1px solid rgba(20, 33, 61, 0.08);\n}\n\n.admin-properties__panel-heading h2,\n.admin-properties__panel-heading p,\n.admin-properties__detail-card h2,\n.admin-properties__action-card h2,\n.admin-properties__candidate h2,\n.admin-properties__report-detail h2 {\n  margin: 0;\n}\n\n.admin-properties__panel-heading p {\n  margin-top: 0.35rem;\n  color: var(--color-text-muted, #6b7280);\n}\n\n.admin-properties__table-wrap {\n  overflow-x: auto;\n}\n\n.admin-properties__table {\n  width: 100%;\n  min-width: 72rem;\n  border-collapse: collapse;\n  text-align: start;\n}\n\n.admin-properties__table th,\n.admin-properties__table td {\n  padding: 1rem 1.1rem;\n  border-bottom: 1px solid rgba(20, 33, 61, 0.08);\n  vertical-align: middle;\n  text-align: start;\n}\n\n.admin-properties__table th {\n  background: rgba(244, 234, 212, 0.42);\n  color: var(--color-text-muted, #6b7280);\n  font-size: 0.82rem;\n  white-space: nowrap;\n}\n\n.admin-properties__table td strong,\n.admin-properties__table td small {\n  display: block;\n}\n\n.admin-properties__table td small {\n  margin-top: 0.3rem;\n  color: var(--color-text-muted, #7f8798);\n}\n\n.admin-properties__table tbody tr:last-child td {\n  border-bottom: 0;\n}\n\n.admin-properties__badge,\n.admin-properties__chip {\n  display: inline-flex;\n  align-items: center;\n  min-height: 2rem