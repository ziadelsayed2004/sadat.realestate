    {
      "name": "Provider - Upload Private Document",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Private upload never exposes storage internals', function () {",
            "  pm.expect([200, 201, 400, 401, 403, 409, 413, 429, 503]).to.include(pm.response.code);",
            "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');",
            "  pm.expect(JSON.stringify(pm.response.json())).to.not.include('storageKey');",
            "});"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/pdf", "type": "text" },
          { "key": "X-Document-Category", "value": "government_id_front", "type": "text" },
          { "key": "X-File-Name", "value": "synthetic-identity.pdf", "type": "text" }
        ],
        "body": { "mode": "file", "file": { "src": "" } },
        "url": {
          "raw": "{{apiV1BaseUrl}}/provider/application/documents",
          "host": ["{{apiV1BaseUrl}}"],
          "path": ["provider", "application", "documents"]
        },
        "description": "Select only an isolated synthetic PDF/JPEG/PNG fixture. The runtime requires a provider bearer session; no token or real document is stored in this collection."
      }
    },
