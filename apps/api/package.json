{
  "name": "@sadat-real-estate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prebuild": "npm run build --workspace @sadat-real-estate/contracts",
    "pretypecheck": "npm run build --workspace @sadat-real-estate/contracts",
    "pretest": "npm run build --workspace @sadat-real-estate/contracts",
    "test": "node --import tsx --test --test-concurrency=1 tests/server.test.ts tests/config/environment.test.ts tests/contracts/error-boundary.test.ts tests/security/middleware.test.ts tests/observability/observability.test.ts tests/database/environment.test.ts tests/database/index-policy.test.ts tests/database/connection.test.ts tests/database/health.test.ts tests/database/seed.test.ts tests/database/artifacts.test.ts",
    "env:check": "tsx src/modules/config/check-environment.ts",
    "api:inventory": "tsx src/modules/database/api-inventory.ts",
    "openapi:validate": "tsx src/modules/database/validate-api-artifacts.ts openapi",
    "postman:validate": "tsx src/modules/database/validate-api-artifacts.ts postman",
    "db:seed": "tsx src/modules/database/run-seed.ts"
  },
  "dependencies": {
    "@sadat-real-estate/contracts": "0.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "9.9.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
