{
  "name": "@sadat-real-estate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:contracts": "npm run build --workspace @sadat-real-estate/contracts",
    "predev": "npm run prepare:contracts",
    "dev": "node server.mjs --mode development",
    "prebuild": "npm run prepare:contracts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts && node scripts/check-bundle-budget.mjs",
    "build:server": "vite build --config vite.config.ts --ssr src/features/frontend_foundation/entry-server.tsx",
    "start": "node server.mjs --mode production",
    "pretypecheck": "npm run prepare:contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \"server.mjs\" --max-warnings=0",
    "pretest": "npm run build",
    "test": "npm run test:vitest && node --import tsx --test tests/accessibility.test.ts tests/auth.test.ts tests/components.test.ts tests/contracts.test.ts tests/design-system.test.ts tests/foundation.test.ts tests/localization.test.ts tests/routing.test.ts tests/ssr.test.mjs tests/ux-states.test.ts",
    "pretest:vitest": "npm run prepare:contracts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config playwright.config.ts",
    "pretest:visual": "npm run build",
    "test:visual": "node scripts/run-visual-matrix.mjs",
    "pretest:a11y": "npm run build",
    "test:a11y": "node scripts/run-accessibility-matrix.mjs",
    "test:performance": "playwright test --config playwright.config.ts tests/e2e/performance.spec.ts",
    "test:security": "playwright test --config playwright.config.ts tests/e2e/security.spec.ts",
    "test:locale": "vitest run --config vitest.config.ts tests/locale-direction.vitest.test.ts",
    "test:uat": "vitest run --config vitest.config.ts tests/uat-binding.vitest.test.ts tests/uat-matrix.vitest.test.ts",
    "test:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@sadat-real-estate/contracts": "0.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
