{
  "name": "@sadat-real-estate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --mode development",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --config vite.config.ts --ssr src/features/frontend_foundation/entry-server.tsx",
    "start": "node server.mjs --mode production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"vite.config.ts\" \"server.mjs\" --max-warnings=0",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test tests/design-system.test.ts tests/foundation.test.ts tests/ssr.test.mjs"
  },
  "dependencies": {
    "@sadat-real-estate/contracts": "0.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "vite": "7.3.6"
  }
}
