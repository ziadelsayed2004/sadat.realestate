# Disposable native Local preview. No Production credentials belong here.
NATIVE_LOCAL_RUNTIME=true
APP_ENV=local

LOCAL_HTTP_PORT=8080
LOCAL_MAIL_UI_PORT=8025
LOCAL_SMTP_PORT=1025
LOCAL_AUTO_SEED=true
# The showcase seed includes two deterministic Local admin accounts. Keep the
# transactional first-Super-Admin bootstrap opt-in: standalone Windows MongoDB
# does not provide transaction semantics; use an isolated replica set/Atlas URI
# before enabling this one-time operation.
LOCAL_AUTO_BOOTSTRAP_ADMIN=false

# Disposable Local-only Super Admin. Never reuse these values outside Local preview.
LOCAL_DEMO_ADMIN_EMAIL=admin.demo@example.invalid
LOCAL_DEMO_ADMIN_PASSWORD="LocalPreview-Admin-Only-2026!"

API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=4173
WEB_PUBLIC_ORIGIN=http://localhost:8080
WEB_API_ORIGIN=http://127.0.0.1:3000

# Supply a locally installed MongoDB service or an isolated non-production MongoDB Atlas URI.
# The native supervisor never downloads or starts MongoDB and never reads Docker state.
MONGODB_URI=mongodb://127.0.0.1:27017/sadat_real_estate_local
AUTH_ACCESS_TOKEN_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1rZXktMzItYnl0ZXM

OTP_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM="Elsadat Local <no-reply@elsadat.local>"
SMTP_PRODUCT_NAME="Elsadat Real Estate Local"

PRIVATE_STORAGE_MODE=local-filesystem
PRIVATE_STORAGE_LOCAL_ROOT=.local/private-uploads
PRIVATE_DOWNLOAD_SIGNING_SECRET=bG9jYWwtZG93bmxvYWQtc2lnbmluZy1rZXktMzItYnl0ZXMhIQ
MALWARE_SCANNER_MODE=deterministic-fake
