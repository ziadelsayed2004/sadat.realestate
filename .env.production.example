# Canonical Production template for BOTH API and Web services.
# Run `npm run production:prepare` to generate secrets into .env.production,
# then set only SMTP_PASSWORD manually. Never commit the generated file.
# Install it on Ubuntu at /etc/elsadatrealestate/production.env as root:elsadat mode 0640.
NATIVE_PRODUCTION_RUNTIME=true
APP_ENV=production
PUBLIC_DOMAIN=elsadatrealestate.com
ACME_EMAIL=info@elsadatrealestate.com

API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=4173
WEB_PUBLIC_ORIGIN=https://elsadatrealestate.com
WEB_API_ORIGIN=http://127.0.0.1:3000

AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
PRIVATE_DOWNLOAD_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_BASE64URL_32_BYTE_SECRET

MONGO_ROOT_USERNAME=sadat_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_ROOT_PASSWORD
MONGO_APP_USERNAME=sadat_app
MONGO_APP_PASSWORD=REPLACE_WITH_URL_SAFE_APP_PASSWORD
MONGO_REPLICA_KEY=REPLACE_WITH_LONG_BASE64_REPLICA_KEY
MONGODB_URI=mongodb://sadat_app:REPLACE_WITH_URL_SAFE_APP_PASSWORD@127.0.0.1:27017/sadat?authSource=sadat&replicaSet=rs0&directConnection=true

OTP_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_TLS=implicit
SMTP_USER=info@elsadatrealestate.com
SMTP_PASSWORD='REPLACE_WITH_HOSTINGER_MAILBOX_PASSWORD'
SMTP_FROM="Elsadat Real Estate <info@elsadatrealestate.com>"
SMTP_PRODUCT_NAME="Elsadat Real Estate"

PRIVATE_STORAGE_MODE=local-filesystem
PRIVATE_STORAGE_LOCAL_ROOT=/var/lib/elsadatrealestate/private
MALWARE_SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

BACKUP_ROOT=/var/backups/elsadatrealestate
BACKUP_RETENTION_DAYS=14
