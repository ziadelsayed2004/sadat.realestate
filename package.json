{
  "name": "sadat-real-estate",
  "version": "0.0.0",
  "private": true,
  "description": "Sadat Real Estate monorepo workspace foundation",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts",
    "packages/ui",
    "packages/config"
  ],
  "scripts": {
    "workspace:check": "node packages/config/scripts/check-workspaces.mjs",
    "typecheck": "node packages/config/scripts/check-syntax.mjs && npm run typecheck --workspace packages/contracts && npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "lint": "npm run workspace:check && eslint \"apps/api/src/**/*.ts\" \"apps/api/tests/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\" \"apps/web/tests/**/*.{ts,tsx}\" \"apps/web/vite.config.ts\" \"apps/web/server.mjs\" \"packages/contracts/src/**/*.ts\" \"packages/config/**/*.mjs\" \"scripts/**/*.mjs\" \"eslint.config.mjs\" --max-warnings=0",
    "test": "node packages/config/scripts/run-tests.mjs && npm run test --workspace apps/web",
    "test:workspace": "node --test packages/config/tests/*.test.mjs",
    "test:unit": "npm run test:unit --workspace apps/api",
    "test:integration": "npm run test:integration --workspace apps/api",
    "test:api": "npm run test:api --workspace apps/api",
    "test:coverage": "npm run test:coverage --workspace apps/api",
    "test:integration:live": "npm run test:integration:live --workspace apps/api",
    "build": "npm run workspace:check && npm run build --workspace packages/contracts && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "quality": "npm run lint && npm run typecheck && npm run test:workspace && npm run test:coverage && npm run build && npm run api:inventory && npm run api:audit && npm run openapi:validate && npm run postman:validate && npm audit --audit-level=high && node agent_pack/scripts/audit_pack.mjs",
    "env:check": "npm run env:check --workspace apps/api",
    "api:inventory": "npm run api:inventory --workspace apps/api",
    "api:audit": "node --import tsx scripts/audit-api-contracts.mjs",
    "openapi:validate": "npm run openapi:validate --workspace apps/api",
    "postman:validate": "npm run postman:validate --workspace apps/api",
    "locale:audit": "node packages/config/scripts/audit-locales.mjs",
    "db:seed": "npm run db:seed --workspace apps/api",
    "auth:migrate-email-only": "npm run auth:migrate-email-only --workspace apps/api",
    "local:doctor": "node scripts/native-local.mjs doctor",
    "local:check": "node scripts/native-local.mjs doctor",
    "local:up": "node scripts/native-local.mjs up",
    "local:down": "node scripts/native-local.mjs down",
    "local:logs": "node scripts/native-local.mjs logs",
    "local:seed": "node scripts/native-local.mjs seed",
    "local:status": "node scripts/native-local.mjs status",
    "local:prepare": "node scripts/prepare-environment.mjs local",
    "local:smoke": "node scripts/runtime-smoke.mjs --require-seeded",
    "production:prepare": "node scripts/prepare-environment.mjs production",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:config": "node scripts/native-production-check.mjs",
    "production:smoke": "node scripts/runtime-smoke.mjs",
    "production:demo:seeker": "bash deploy/native/create-demo-account.sh seeker",
    "production:demo:provider": "bash deploy/native/create-demo-account.sh provider",
    "smtp:check": "node scripts/smtp-smoke.mjs",
    "smtp:smoke": "node scripts/smtp-smoke.mjs --send",
    "dev": "npm run dev --workspace apps/api",
    "start": "npm run start --workspace apps/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "typescript-eslint": "8.67.0"
  }
}
