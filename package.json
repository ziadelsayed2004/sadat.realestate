{
  "name": "sadat-real-estate",
  "version": "0.0.0",
  "private": true,
  "description": "Sadat Real Estate monorepo workspace foundation",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts",
    "packages/ui",
    "packages/config"
  ],
  "scripts": {
    "workspace:check": "node packages/config/scripts/check-workspaces.mjs",
    "typecheck": "node packages/config/scripts/check-syntax.mjs && npm run typecheck --workspace packages/contracts && npm run typecheck --workspace apps/api",
    "lint": "npm run workspace:check",
    "test": "node packages/config/scripts/run-tests.mjs",
    "build": "npm run workspace:check && npm run build --workspace packages/contracts && npm run build --workspace apps/api",
    "env:check": "npm run env:check --workspace apps/api",
    "api:inventory": "npm run api:inventory --workspace apps/api",
    "openapi:validate": "npm run openapi:validate --workspace apps/api",
    "postman:validate": "npm run postman:validate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "dev": "npm run dev --workspace apps/api",
    "start": "npm run start --workspace apps/api"
  }
}
