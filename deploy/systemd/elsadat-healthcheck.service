[Unit]
Description=Elsadat Real Estate local dependency health check
After=elsadat-api.service elsadat-web.service
Requires=elsadat-api.service elsadat-web.service

[Service]
Type=oneshot
User=elsadat
Group=elsadat
ExecStart=/opt/elsadatrealestate/current/deploy/native/healthcheck.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
